<% layout("/layouts/boilerplate") %>

    <style>
        #filters {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
            gap: 2rem;
            margin-top: 1rem;
        }
        .filter {
            text-align: center;
            opacity: 0.7;
        }
        .filter:hover {
            opacity: 1;
            cursor: pointer;
        }
        .filter p {
            font-size: 0.9rem;
        }
        .filter a {
            color: inherit;
            text-decoration: none;
        }
        .filter.active {
            opacity: 1;
            color: #000;
        }
        .tax-info {
            display: none;
            font-size: 12px;
        }

        .tax-toggle {
            border: 1.5px solid black;
            
            
            border-radius: 1rem;
            height: 3rem;    
            padding: 1rem;
            display: flex;       
            align-items: center;

            margin-top: -1.2rem;
            font-weight: 400;
        }
    </style>

     <div id="filters" >
        <div class="filter <%= category === 'Trending' ? 'active' : '' %>">
           
            <a href="/listings?search=<%= encodeURIComponent(search || '') %>&maxPrice=<%= maxPrice || '' %>&category=Trending">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
            </a>
        </div>

        <div class="filter <%= category === 'Rooms' ? 'active' : '' %>">
            <a href="/listings?search=<%= encodeURIComponent(search || '') %>&maxPrice=<%= maxPrice || '' %>&category=Rooms">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
            </a>
        </div>

        <div class="filter <%= category === 'Iconic Cities' ? 'active' : '' %>">
            <a href="/listings?search=<%= encodeURIComponent(search || '') %>&maxPrice=<%= maxPrice || '' %>&category=Iconic%20Cities">
            <div><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic cities</p>
            </a>
        </div>

        <div class="filter <%= category === 'Mountains' ? 'active' : '' %>">
            <a href="/listings?search=<%= encodeURIComponent(search || '') %>&maxPrice=<%= maxPrice || '' %>&category=Mountains">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
            </a>
        </div>

        <div class="filter <%= category === 'Castles' ? 'active' : '' %>">
            <a href="/listings?search=<%= encodeURIComponent(search || '') %>&maxPrice=<%= maxPrice || '' %>&category=Castles">
            
                <div><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castles</p>
            </a>
        </div>

        <div class="filter <%= category === 'Amazing Pools' ? 'active' : '' %>">
            <a href="/listings?search=<%= encodeURIComponent(search || '') %>&maxPrice=<%= maxPrice || '' %>&category=Amazing%20Pools">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing Pools</p>
            
        </a>
        </div>

        <div class="filter <%= category === 'Camping' ? 'active' : '' %>">
            <a href="/listings?search=<%= encodeURIComponent(search || '') %>&maxPrice=<%= maxPrice || '' %>&category=Camping">
            <div><i class="fa-solid fa-tents"></i></div>
            <p>Camping</p>
            </a>
        </div>

        <div class="filter <%= category === 'Farms' ? 'active' : '' %>">
            <a href="/listings?search=<%= encodeURIComponent(search || '') %>&maxPrice=<%= maxPrice || '' %>&category=Farms">
            <div><i class="fa-solid fa-cow"></i></div>
            <p>Farms</p>
            </a>
        </div>

        <div class="filter <%= category === 'Arctic' ? 'active' : '' %>">
            <a href="/listings?search=<%= encodeURIComponent(search || '') %>&maxPrice=<%= maxPrice || '' %>&category=Arctic">
            <div><i class="fa-solid fa-snowman"></i></div>
            <p>Arctic</p>
            </a>
        </div>

        <div class="filter <%= category === 'Domes' ? 'active' : '' %>">
            <a href="/listings?search=<%= encodeURIComponent(search || '') %>&maxPrice=<%= maxPrice || '' %>&category=Domes">
            <div><i class="fa-solid fa-landmark-dome"></i></div>
            <p>Domes</p>
            </a>
        </div>

        <div class="filter <%= category === 'Boats' ? 'active' : '' %>">
            <a href="/listings?search=<%= encodeURIComponent(search || '') %>&maxPrice=<%= maxPrice || '' %>&category=Boats">
            <div><i class="fa-solid fa-ship"></i></div>
            <p>Boats</p>
            </a>
        </div>

        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault"/>
                
                <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
            </div>
        
        
        </div>
    </div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <%for (let i=0; i < allListing.length; i++) { %>
        
        <a href="/listings/<%= allListing[i]._id %>" class="listing-link">
            <div class="card col listing-card">
                <img src="<%= allListing[i].image.url %>" class="card-img-top" alt="listing_image" style = "height: 20rem">
                <div class="card-img-overlay"></div>
                <div class="card-body">
                    <p class="card-text">
                        <b><%= allListing[i].title %></b> <br>

                        &#8377; <%= allListing[i].price.toLocaleString("en-IN") %> / night
                        <i class="tax-info"> &nbsp; &nbsp +18% GST</i>
                    </p>
                </div>
            </div>
        </a>
    <%}%>
    <% if (allListing.length === 0) { %>
    <div class="w-100 text-center mt-5">
        <h3>No listings found!</h3>
        <p class="text-muted">
            Try searching with another name, country or location.
        </p>
    </div>
<% } %>
</div>

<script>
    let taxSwitch = document.getElementById("flexSwitchCheckDefault");
        taxSwitch.addEventListener("click", () => {
            let taxInfo = document.getElementsByClassName("tax-info");
            for (let i = 0; i < taxInfo.length; i++) {
                if (taxSwitch.checked) {
                    taxInfo[i].style.display = "inline";
                } else {  
                    taxInfo[i].style.display = "none";
                }
            }
        });
        
</script>